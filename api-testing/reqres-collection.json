{
  "info": {
    "_postman_id": "0a1d0389-5ed4-4a34-bb48-9eac51bd176b",
    "name": "reqres-api-tests",
    "description": "Тесты публичного API https://reqres.in.\n\nВАЖНО: с 2024 г. все /api/* требуют заголовок `x-api-key`. Он задан на уровне коллекции (auth → API Key) и берётся из переменной {{apiKey}} = reqres-free-v1. Без него reqres вернёт 401, и все тесты упадут.\n\nПеременные: {{baseUrl}} = https://reqres.in, {{apiKey}} = reqres-free-v1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "x-api-key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "GET list users (page 2)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test(\"Body has a data field\", () => {",
              "    pm.expect(json).to.have.property('data');",
              "});",
              "",
              "pm.test(\"data is a non-empty array\", () => {",
              "    pm.expect(json.data).to.be.an(\"array\").that.is.not.empty;",
              "});",
              "",
              "pm.test(\"page in response matches the one we asked for\", () => {",
              "    pm.expect(json.page).to.eql(2);",
              "});",
              "",
              "pm.test(\"each user has id and email\", () => {",
              "    json.data.forEach(u => {",
              "        pm.expect(u).to.have.property('id');",
              "        pm.expect(u).to.have.property('email');",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users?page=2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ],
          "query": [
            {
              "key": "page",
              "value": "2"
            }
          ]
        },
        "description": "Постраничный список пользователей. Проверяем структуру и что вернулась запрошенная страница."
      },
      "response": []
    },
    {
      "name": "GET single user (id=2)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test(\"data.id equals 2\", () => {",
              "    pm.expect(json.data.id).to.eql(2);",
              "});",
              "",
              "pm.test(\"user object has email, first_name, last_name\", () => {",
              "    pm.expect(json.data).to.have.all.keys('id', 'email', 'first_name', 'last_name', 'avatar');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "2"
          ]
        },
        "description": "Получение одного существующего пользователя."
      },
      "response": []
    },
    {
      "name": "GET missing user (id=23) -> 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 404\", () => {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test(\"body is an empty object\", () => {",
              "    pm.expect(pm.response.json()).to.eql({});",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/23",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "23"
          ]
        },
        "description": "Несуществующий пользователь — ожидаем 404 и пустое тело."
      },
      "response": []
    },
    {
      "name": "POST create user -> 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test(\"response has an id\", () => {",
              "    pm.expect(json).to.have.property('id');",
              "});",
              "",
              "pm.test(\"response echoes name and job we sent\", () => {",
              "    pm.expect(json.name).to.eql(\"Данила\");",
              "    pm.expect(json.job).to.eql(\"QA\");",
              "});",
              "",
              "pm.test(\"createdAt is present\", () => {",
              "    pm.expect(json).to.have.property('createdAt');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Данила\",\n  \"job\": \"QA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Создание пользователя. reqres всегда возвращает 201 с id и createdAt (данные нигде не сохраняются — это мок)."
      },
      "response": []
    },
    {
      "name": "PUT update user (id=2) -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test(\"updatedAt is present\", () => {",
              "    pm.expect(json).to.have.property('updatedAt');",
              "});",
              "",
              "pm.test(\"job was updated to Senior QA\", () => {",
              "    pm.expect(json.job).to.eql(\"Senior QA\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "2"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Данила\",\n  \"job\": \"Senior QA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Обновление пользователя через PUT."
      },
      "response": []
    },
    {
      "name": "DELETE user (id=2) -> 204",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 204\", () => {",
              "    pm.response.to.have.status(204);",
              "});",
              "",
              "pm.test(\"response body is empty\", () => {",
              "    pm.expect(pm.response.text()).to.be.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "2"
          ]
        },
        "description": "Удаление пользователя — 204 No Content, тело пустое."
      },
      "response": []
    },
    {
      "name": "POST login (valid) -> 200 + token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test(\"response has a token\", () => {",
              "    pm.expect(json).to.have.property('token');",
              "    pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "// Стандартный рабочий аккаунт reqres. Любой другой email/пароль из",
              "// этого мока тоже отдаёт токен — пароль реально не проверяется."
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"eve.holt@reqres.in\",\n  \"password\": \"cityslicka\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Успешный логин валидными данными. eve.holt@reqres.in / cityslicka — дефолтный тестовый аккаунт reqres."
      },
      "response": []
    },
    {
      "name": "POST login (no password) -> 400 + error",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test(\"response has an error message\", () => {",
              "    pm.expect(json).to.have.property('error');",
              "});",
              "",
              "pm.test(\"error text mentions the missing password\", () => {",
              "    pm.expect(json.error).to.eql(\"Missing password\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"eve.holt@reqres.in\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Логин без пароля — негативный кейс, ожидаем 400 и текст ошибки."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://reqres.in",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "reqres-free-v1",
      "type": "string"
    }
  ]
}